# Supabase Pooler URL (port 6543) — used at runtime by Prisma
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct URL (port 5432) — used by Prisma for migrations only
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"
API_SECRET="replace-with-a-long-random-secret"
